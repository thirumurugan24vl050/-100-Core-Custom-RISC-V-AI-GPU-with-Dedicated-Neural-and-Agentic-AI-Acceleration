# Cadence Incisive Coverage Configuration File (cov_config.ccf)
# Enable Full Coverage Scoring for Block, Expression, Toggle, FSM, Assertion & Functional

set_expr_coverable_operators -all
set_expr_coverable_statements -all
set_expr_scoring -struct
set_toggle_scoring -sv_enum
set_toggle_scoring -sv_mda 24
set_covergroup -new_instance_reporting

// select_coverage lines removed, handled by -coverage all in irun
